# SMTP Configuration for email notifications
# En desarrollo, dejar vacío para usar solo LoggingLeadNotifier
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@eitec.coop.ar
SMTP_TLS=true

# reCAPTCHA v2 Configuration
# Obtener en https://www.google.com/recaptcha/admin
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Feature Flags (true/false)
ENABLE_PDF_GENERATOR=false
ENABLE_BLOG=false
